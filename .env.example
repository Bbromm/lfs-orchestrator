# =============================================================================
# LFS Orchestrator — переменные окружения
# Скопируйте в .env и отредактируйте:
#     cp .env.example .env
#
# Все переменные читаются с префиксом LFS_ (pydantic env_prefix="LFS_"):
# поле root → LFS_ROOT, db_path → LFS_DB_PATH и т.д.
# Голые имена (ROOT=, DB_PATH=, MAX_PARALLEL=) НЕ работают.
# =============================================================================

# --- Пути -------------------------------------------------------------------
# Корень будущей LFS-системы
LFS_ROOT=/mnt/lfs

# Каталог исходников (tarball'ы + патчи)
LFS_SOURCES=/mnt/lfs/sources

# Целевой триплет кросс-компиляции
LFS_TGT=x86_64-lfs-linux-gnu

# --- Исполнитель ------------------------------------------------------------
# chroot | local | lfs | root | ssh (для ssh заполните LFS_SSH_*)
LFS_EXECUTOR=chroot
#LFS_SSH_HOST=
#LFS_SSH_USER=root
#LFS_SSH_KEY=

# --- Состояние и логи -------------------------------------------------------
LFS_DB_PATH=/mnt/lfs/lfs-orchestrator/data/orchestrator.db
LFS_LOGS_DIR=/mnt/lfs/lfs-orchestrator/logs

# --- Параллелизм и поведение ------------------------------------------------
# LFS нельзя параллелить: стадии одной главы идут строго по порядку
LFS_MAX_PARALLEL=1
LFS_RUN_TESTS=false
LFS_STOP_ON_ERROR=true

# --- Веб-интерфейс ----------------------------------------------------------
LFS_ORCH_HOST=0.0.0.0
LFS_ORCH_PORT=8100
LFS_ORCH_LOG_LEVEL=INFO